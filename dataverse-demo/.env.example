# Copy to .env before running: cp .env.example .env
# .env itself is gitignored — never commit real values.

# Key required to call Dataverse's "blocked" admin API endpoints once the
# demo persona locks them down (see demo/init.sh). Change this to something
# only people running this demo know — the official Dataverse docs
# explicitly call out not leaving this as "unblockme".
BLOCKED_API_KEY=change-me-before-running

# Where Dataverse stores uploaded files, inside the dataverse container.
# /dv is the one meaningfully persisted volume for that container
# (./data/app/data:/dv in compose.yml) — leave this as /dv unless you've
# added another volume mount to store files elsewhere.
STORAGE_DIR=/dv

# Only needed if people on other machines need to reach this instance by
# your machine's LAN IP instead of localhost (e.g. a live workshop where
# attendees hit your machine directly). Leave unset for a single-machine demo.
#MACHINE_IP=192.168.1.100

# Needed by the uploader service (dataverse-demo/uploader/) to call Dataverse's
# native API on attendees' behalf. Get one from the running instance:
# ./scripts/get_admin_token.sh, or the UI (Account -> API Token). Without
# this the upload form loads but every upload fails with a clear error.
DATAVERSE_API_TOKEN=

# Collection alias the uploader creates datasets in — must already exist
# (see scripts/smoke_test.sh's "create collection" step, or create one from
# the Dataverse UI). Defaults to "root" if unset.
#DATAVERSE_COLLECTION_ALIAS=metagen-demo

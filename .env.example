# LLM Provider API Keys (at least one required)
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...
OPENCODE_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
# Z.AI coding plan (provider zai-coding-plan). Also the default LLM-as-judge for
# the dev eval scripts (config/eval.yaml: judge zai-coding-plan:glm-5.3).
ZAI_API_KEY=...

# Optional: Override default OpenAI base URL (for OpenAI-compatible providers)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: ORCID Public API credentials — only needed to resolve personal
# creators to ORCID iDs (enable_identifier_enrichment). Free self-service
# registration: https://orcid.org/developer-tools
# ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
# ORCID_CLIENT_SECRET=...
